# AI Employee Configuration (Silver Tier)
# Copy this file to .env and update values as needed

# ============================================================
# Safety
# ============================================================

# When true, all actions are logged but NOT executed
# Set to false only when you're ready for live operation
DRY_RUN=true

# ============================================================
# Vault
# ============================================================

# Path to the Obsidian vault directory (relative to repo root)
VAULT_PATH=./vault

# ============================================================
# Watcher Intervals (seconds)
# ============================================================

# Filesystem watcher check interval
CHECK_INTERVAL=10

# Gmail polling interval (default: 60s, stays within API quotas)
GMAIL_POLL_INTERVAL=60

# WhatsApp Web scanning interval (default: 30s)
WHATSAPP_POLL_INTERVAL=30

# ============================================================
# Gmail API (OAuth2)
# ============================================================

# Path to Google Cloud OAuth2 credentials file
# Download from: Google Cloud Console → APIs & Services → Credentials
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Path where Gmail watcher stores its OAuth2 token (auto-created after first auth)
GMAIL_TOKEN_PATH=./token.json

# ============================================================
# Email MCP Server (Node.js)
# ============================================================

# Path where email-mcp stores its OAuth2 token (separate from watcher token)
EMAIL_MCP_TOKEN_PATH=./token-mcp.json

# ============================================================
# WhatsApp (Playwright)
# ============================================================

# Directory where Playwright stores WhatsApp Web browser session
# First run: use --setup flag to scan QR code
WHATSAPP_USER_DATA_DIR=./playwright-data/whatsapp

# ============================================================
# LinkedIn (Playwright)
# ============================================================

# Directory where Playwright stores LinkedIn browser session
# First run: use --setup flag to login manually
LINKEDIN_USER_DATA_DIR=./playwright-data/linkedin

# ============================================================
# Scheduling
# ============================================================

# LinkedIn daily post time (24h format, weekdays only)
LINKEDIN_POST_TIME=09:00

# CEO briefing day and time
BRIEFING_DAY=MON
BRIEFING_TIME=08:00
