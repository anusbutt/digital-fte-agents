# Email MCP Server Environment Variables
# Copy to .env and fill in your values

# Path to Google Cloud OAuth2 credentials JSON
# Download from: Google Cloud Console > APIs & Credentials > OAuth 2.0 Client IDs
GOOGLE_CREDENTIALS_PATH=../credentials.json

# Path to store OAuth2 token (auto-generated after first auth)
EMAIL_MCP_TOKEN_PATH=../token-mcp.json
